{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upkeep",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/feed/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "upkeep",
      "database_id": "3d87df38-29de-4ea0-8a76-25d038554604",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access. Leave empty locally; set both in production.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
