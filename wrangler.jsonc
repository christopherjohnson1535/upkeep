{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upkeep",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/feed/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "upkeep",
      "database_id": "3d87df38-29de-4ea0-8a76-25d038554604",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "BACKUPS", "id": "eb78f22ab2384e109a320bb05928a34c" }],
  "triggers": {
    // nightly backup, a little after 3am Mountain
    "crons": ["17 9 * * *"]
  },
  "vars": {
    // Optional human check on sign-up. Set this and the TURNSTILE_SECRET secret together.
    "TURNSTILE_SITE_KEY": ""
  }
}
